                        </Border>
                        <StackPanel x:Name="CodeInspectorPanel" Grid.Column="2" Spacing="12">
                            <InfoBar x:Name="EditorInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Editor ready" Message="Enter a Studio script path and choose Pull." />
                            <Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Editor commands" FontSize="17" FontWeight="SemiBold" /><Grid RowSpacing="8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Button Click="EditorFindButton_Click" Content="Find / replace" /><Button Grid.Column="1" Click="EditorGoToLineButton_Click" Content="Go to line" /><Button Grid.Row="1" Click="EditorCommandPaletteButton_Click" Content="Command palette" /><Button Grid.Row="1" Grid.Column="1" Click="EditorFormatButton_Click" Content="Format document" /><Button Grid.Row="2" Grid.ColumnSpan="2" Click="EditorDiagnosticsButton_Click" Content="Run Luau diagnostics" /></Grid><TextBlock x:Name="EditorToolsStatusText" Text="Checking local editor tools…" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Style="{ThemeResource SectionCardStyle}">
                                <StackPanel Spacing="8"><TextBlock Text="Source safety" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="EditorHashText" Text="Source hash  --" FontFamily="Consolas" TextWrapping="Wrap" /><TextBlock Text="Push uses the pulled hash for conflict detection, previews the Studio diff, and reads the committed source back before reporting success." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Style="{ThemeResource SectionCardStyle}">
                                <StackPanel Spacing="8"><TextBlock Text="Preview" FontSize="17" FontWeight="SemiBold" /><TextBox x:Name="EditorDiffTextBox" Text="No preview yet." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" /></StackPanel>
                            </Border>
                            <Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Diagnostics" FontSize="17" FontWeight="SemiBold" /><TextBox x:Name="EditorDiagnosticsTextBox" Text="No diagnostics have run." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="130" ScrollViewer.VerticalScrollBarVisibility="Auto" /></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="ReviewPage" Visibility="Collapsed" Padding="28,18,28,28" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{ThemeResource HeroCardStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="SAFE DELIVERY" Style="{ThemeResource EyebrowTextStyle}" />
                                <TextBlock Text="Change Review" Style="{ThemeResource PageTitleStyle}" />
                                <TextBlock Text="Understand scope, risk, validation, and the exact Studio operation before approving it." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Padding="11,7" CornerRadius="12" Background="{ThemeResource BrandSecondarySoftBrush}"><TextBlock x:Name="ReviewLowRiskText" Text="0 low" Foreground="{ThemeResource BrandSecondaryBrush}" /></Border>
                                <Border Padding="11,7" CornerRadius="12" Background="{ThemeResource BrandAccentSoftBrush}"><TextBlock x:Name="ReviewMediumRiskText" Text="0 medium" Foreground="{ThemeResource BrandAccentBrush}" /></Border>
                                <Border Padding="11,7" CornerRadius="12" Background="{ThemeResource BrandWarmSoftBrush}"><TextBlock x:Name="ReviewHighRiskText" Text="0 high" Foreground="{ThemeResource BrandWarmBrush}" /></Border>
                                <Button Click="RefreshChangeReviewButton_Click" Width="40" Height="40" Padding="0" ToolTipService.ToolTip="Refresh staged changes"><SymbolIcon Symbol="Refresh" /></Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <InfoBar x:Name="ReviewInfoBar" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="No changes staged" Message="Dirty editor buffers and queued commands appear here automatically." />
                    <Grid Grid.Row="2" ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                        <Border Style="{ThemeResource SectionCardStyle}" Background="{ThemeResource CardSurfaceStrongBrush}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Spacing="2"><TextBlock Text="Staged changes" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Local drafts and approval-queue mutations" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                <ListView x:Name="ChangeReviewList" Grid.Row="1" SelectionMode="Single" SelectionChanged="ChangeReviewList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,9" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Target}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Padding="9,4" CornerRadius="10" Background="{ThemeResource BrandWarmSoftBrush}" VerticalAlignment="Top"><TextBlock Text="{Binding Risk}" Foreground="{ThemeResource BrandWarmBrush}" FontWeight="SemiBold" /></Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Grid.Row="2" Click="DismissReviewItemButton_Click" Content="Dismiss from review" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{ThemeResource SectionCardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Spacing="3"><TextBlock x:Name="ReviewDetailTitle" Text="Select a staged change" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ReviewDetailTarget" Text="No target selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="10,5" CornerRadius="10" Background="{ThemeResource BrandAccentSoftBrush}"><TextBlock x:Name="ReviewDetailRisk" Text="Risk --" Foreground="{ThemeResource BrandAccentBrush}" FontWeight="SemiBold" /></Border>
                                </Grid>
                                <Border Grid.Row="1" Padding="12" CornerRadius="12" Background="{ThemeResource BrandAccentSoftBrush}">
                                    <StackPanel Spacing="4"><TextBlock Text="What will happen" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" /><TextBlock x:Name="ReviewExplanationText" Text="Choose an item to inspect its intended operation." TextWrapping="Wrap" /></StackPanel>
                                </Border>
                                <Border Grid.Row="2" Padding="12" CornerRadius="12" Background="{ThemeResource BrandSecondarySoftBrush}">
                                    <StackPanel Spacing="4"><TextBlock Text="Preflight" FontWeight="SemiBold" Foreground="{ThemeResource BrandSecondaryBrush}" /><TextBlock x:Name="ReviewValidationText" Text="No validation has run." TextWrapping="Wrap" /></StackPanel>
                                </Border>
                                <TextBox x:Name="ReviewDiffTextBox" Grid.Row="3" Header="Exact preview / arguments" Text="Select a change to inspect it." IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap" MinHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                <Grid Grid.Row="4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Every apply requires confirmation. Nothing on this page runs automatically." Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="RollbackLastChangeButton" Grid.Column="1" Click="RollbackLastChangeButton_Click" IsEnabled="False" Content="Rollback last source apply" />
                                    <Button x:Name="ApplyReviewedChangeButton" Grid.Column="2" Style="{ThemeResource BrandPrimaryButtonStyle}" Click="ApplyReviewedChangeButton_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Accept" /><TextBlock Text="Apply selected" /></StackPanel></Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="AiPage" Visibility="Collapsed" Padding="28,18,28,28" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{ThemeResource HeroCardStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="LOCAL INTELLIGENCE" Style="{ThemeResource EyebrowTextStyle}" />
                                <TextBlock Text="Studio Copilot" Style="{ThemeResource PageTitleStyle}" />
                                <TextBlock Text="Ask about the live place. Abraxius retrieves task-relevant context through AXL before the model answers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="12,7" CornerRadius="12" Background="{ThemeResource BrandSecondarySoftBrush}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="AiProviderDot" Width="8" Height="8" Fill="{ThemeResource BrandSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AiProviderStatusText" Text="Checking Ollama" Foreground="{ThemeResource BrandSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid x:Name="AiWorkspaceGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AiContextColumn" Width="320" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{ThemeResource SectionCardStyle}" Padding="14" Background="{ThemeResource CardSurfaceStrongBrush}">
                            <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="AiModelPicker" Header="Ollama model" PlaceholderText="Select a model" DisplayMemberPath="DisplayName" /><Button Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshAiModelsButton_Click" Background="{ThemeResource BrandSecondarySoftBrush}" Foreground="{ThemeResource BrandSecondaryBrush}"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Refresh" /><TextBlock Text="Refresh" /></StackPanel></Button></Grid><TextBox x:Name="AiTranscriptTextBox" Grid.Row="1" Text="Abraxius AI is ready. Choose a model and send a message." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Background="{ThemeResource AppCanvasBrush}" BorderThickness="0" CornerRadius="12" Padding="14" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{ThemeResource SectionCardStyle}" Padding="12" Background="{ThemeResource BrandAccentSoftBrush}" BorderBrush="{ThemeResource BrandAccentSoftBrush}">
                            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="AiPromptTextBox" PlaceholderText="Ask about the open place, editor source, or runtime output…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" /><Button x:Name="SendAiMessageButton" Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource BrandPrimaryButtonStyle}" Click="SendAiMessageButton_Click" Content="Send" /><Button x:Name="CancelAiMessageButton" Grid.Column="2" VerticalAlignment="Center" Click="CancelAiMessageButton_Click" Content="Cancel" IsEnabled="False" /></Grid>
                        </Border>
                        <ScrollViewer x:Name="AiContextPanel" Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
                            <InfoBar x:Name="AiContextInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Task-aware context" Message="AXL scouts the live place for each request. Nothing is changed without your approval." />
                            <Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="10"><TextBlock Text="Project memory" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource BrandWarmBrush}" /><TextBlock x:Name="AiProjectIdentityText" Text="Resolving Studio project…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBox x:Name="AiProjectInstructionsTextBox" Header="Project instructions" PlaceholderText="Architecture, conventions, safety rules…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" /><Button Click="SaveAiProjectInstructionsButton_Click" Content="Save instructions" /><TextBox x:Name="AiMemoryInputTextBox" Header="Pin memory" PlaceholderText="A durable project fact" /><Button Click="AddAiMemoryButton_Click" Content="Add memory" /><ListView x:Name="AiMemoryList" Height="130" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="2,5"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxLines="3" /><TextBlock Text="{Binding CreatedAt}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button Click="DeleteAiMemoryButton_Click" Content="Delete selected memory" /></StackPanel></Border>
                            <Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="12"><TextBlock Text="Context strategy" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" /><ToggleSwitch x:Name="AiAxlContextToggle" Header="Task-aware AXL retrieval" IsOn="True" /><NumberBox x:Name="AiAxlBudgetBox" Header="AXL token budget" Value="1200" Minimum="256" Maximum="8000" SmallChange="128" SpinButtonPlacementMode="Compact" /><ToggleSwitch x:Name="AiResearchModeToggle" Header="Read-only Research mode" IsOn="True" /><TextBlock Text="Up to 6 bounded AXL reads across 2 rounds. Patch and execute are never available." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" /><TextBlock x:Name="AiResearchReceiptText" Text="No research run yet" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><ToggleSwitch x:Name="AiStudioContextToggle" Header="Full Studio snapshot (uses more tokens)" IsOn="False" /><ToggleSwitch x:Name="AiEditorContextToggle" Header="Unsaved active editor source" IsOn="True" /><ToggleSwitch x:Name="AiRuntimeContextToggle" Header="Recent runtime errors and warnings" IsOn="True" /><Button Click="PreviewAiContextButton_Click" Content="Preview assembled context" /></StackPanel></Border>
                            <Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="8"><TextBlock Text="Session and handoff" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource BrandSecondaryBrush}" /><ToggleSwitch x:Name="AiLocalModelsOnlyToggle" Header="Local models only" IsOn="True" Toggled="AiLocalModelsOnlyToggle_Toggled" /><TextBlock x:Name="AiContextSizeText" Text="Context not built" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><Button Click="DraftAiCommandPlanButton_Click" Content="Draft command plan" /><Button Click="GenerateAiBriefingButton_Click" Content="Generate compact briefing" /><Button Click="ExportAiProjectButton_Click" Content="Export memory and conversation" /><Button Click="CompactAiConversationButton_Click" Content="Compact conversation into memory" /><Button Click="ClearAiConversationButton_Click" Content="Clear conversation" /></StackPanel></Border>
                        </StackPanel></ScrollViewer>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="CommandsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="CommandsLayoutGrid" Padding="32,24,32,32" HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Commands" Style="{ThemeResource PageTitleStyle}" />
                                <TextBlock Text="Choose a task, fill in the details, then inspect or send mutations to Change Review." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <InfoBar x:Name="CommandInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Discovering Studio commands" Message="Connect the Studio companion to load its command schemas." />
                            <Border Style="{ThemeResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="What do you want to do?" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Start with a common task or browse every available Studio operation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button Tag="get_selection" Click="CommandShortcutButton_Click" HorizontalAlignment="Stretch"><StackPanel Spacing="3"><TextBlock Text="Inspect selection" FontWeight="SemiBold" /><TextBlock Text="See what is selected" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Button>
                                            <Button Grid.Column="1" Tag="read_source" Click="CommandShortcutButton_Click" HorizontalAlignment="Stretch"><StackPanel Spacing="3"><TextBlock Text="Read a script" FontWeight="SemiBold" /><TextBlock Text="Inspect source safely" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Button>
                                            <Button Grid.Column="2" Tag="get_properties" Click="CommandShortcutButton_Click" HorizontalAlignment="Stretch"><StackPanel Spacing="3"><TextBlock Text="Inspect properties" FontWeight="SemiBold" /><TextBlock Text="Read instance values" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Button>
                                            <Button Grid.Row="1" Tag="create_script" Click="CommandShortcutButton_Click" HorizontalAlignment="Stretch" Background="{ThemeResource BrandAccentSoftBrush}"><StackPanel Spacing="3"><TextBlock Text="Create a script" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" /><TextBlock Text="Stage a new script" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Button>
                                            <Button Grid.Row="1" Grid.Column="1" Tag="multi_edit" Click="CommandShortcutButton_Click" HorizontalAlignment="Stretch" Background="{ThemeResource BrandAccentSoftBrush}"><StackPanel Spacing="3"><TextBlock Text="Edit a script" FontWeight="SemiBold" Foreground="{ThemeResource BrandAccentBrush}" /><TextBlock Text="Review exact replacements" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Button>
                                            <Button Grid.Row="1" Grid.Column="2" Tag="set_properties" Click="CommandShortcutButton_Click" HorizontalAlignment="Stretch" Background="{ThemeResource BrandWarmSoftBrush}"><StackPanel Spacing="3"><TextBlock Text="Change properties" FontWeight="SemiBold" Foreground="{ThemeResource BrandWarmBrush}" /><TextBlock Text="Stage instance updates" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Button>
                                        </Grid>
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="CommandSearchTextBox" Header="Browse all commands" PlaceholderText="Search by name" TextChanged="CommandSearchTextBox_TextChanged" />
                                        <ComboBox x:Name="CommandCategoryPicker" Grid.Column="1" Header="Category" SelectedIndex="0" SelectionChanged="CommandCategoryPicker_SelectionChanged"><ComboBoxItem Content="All commands" Tag="all" /><ComboBoxItem Content="Favorites" Tag="favorites" /><ComboBoxItem Content="Read and inspect" Tag="read" /><ComboBoxItem Content="Scripts" Tag="scripts" /><ComboBoxItem Content="Instances" Tag="instances" /><ComboBoxItem Content="Runtime" Tag="runtime" /></ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CommandPicker" Header="Studio operation" PlaceholderText="Select a command" IsTextSearchEnabled="True" SelectionChanged="CommandPicker_SelectionChanged" />
                                        <Button x:Name="FavoriteCommandButton" Grid.Column="1" VerticalAlignment="Bottom" Click="FavoriteCommandButton_Click" IsEnabled="False" Content="☆ Favorite" />
                                        <Button Grid.Column="2" VerticalAlignment="Bottom" Click="DiscoverCommandsButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Refresh" /><TextBlock Text="Discover" /></StackPanel></Button>
                                    </Grid>
                                    <Border Padding="13" CornerRadius="12" Background="{ThemeResource BrandAccentSoftBrush}">
                                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="CommandFriendlyNameText" Text="Choose an operation" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="CommandDescriptionText" Text="A plain-language explanation will appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Padding="10,5" CornerRadius="10" Background="{ThemeResource BrandWarmSoftBrush}" VerticalAlignment="Center"><TextBlock x:Name="CommandRiskText" Text="Risk --" Foreground="{ThemeResource BrandWarmBrush}" FontWeight="SemiBold" /></Border></Grid>
                                    </Border>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Details" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Required fields are marked with an asterisk. Optional fields can be left blank." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <StackPanel x:Name="StructuredArgumentsPanel" Spacing="12"><TextBlock Text="Select a command to generate its form." Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                    </StackPanel>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CommandPresetPicker" Header="Saved preset" PlaceholderText="Choose a preset" SelectionChanged="CommandPresetPicker_SelectionChanged" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="SaveCommandPresetButton_Click" Content="Save preset" />
                                        <Button Grid.Column="2" VerticalAlignment="Bottom" Click="DeleteCommandPresetButton_Click" Content="Delete" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="QueueCommandButton" Style="{ThemeResource BrandPrimaryButtonStyle}" Click="QueueCommandButton_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Permissions" /><TextBlock Text="Add to Change Review" /></StackPanel></Button>
                                        <Button x:Name="RunCommandButton" Click="RunCommandButton_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Play" /><TextBlock x:Name="RunCommandLabel" Text="Run inspection" /></StackPanel></Button>
                                        <ProgressRing x:Name="CommandProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Expander Header="Advanced JSON and schema" IsExpanded="False">
                                        <StackPanel Spacing="12" Padding="0,8,0,4">
                                            <TextBox x:Name="CommandArgumentsTextBox" Header="Arguments (JSON object)" Text="{}" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="NoWrap" MinHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextChanged="CommandArgumentsTextBox_TextChanged" />
                                            <Expander Header="Live command schema" IsExpanded="False"><TextBlock x:Name="CommandSchemaText" Text="Select a command to inspect its schema." FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="220" /></Expander>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                            <Expander Header="Latest result" IsExpanded="False">
                                <Border Style="{ThemeResource SectionCardStyle}">
                                    <TextBox x:Name="CommandResultTextBox" Text="No command has run yet." IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="NoWrap" MinHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                </Border>
                            </Expander>
                        </StackPanel>
                        <Border x:Name="ApprovalQueuePanel" Grid.Column="1" Style="{ThemeResource SectionCardStyle}" Margin="0,66,0,0">
                            <StackPanel Spacing="12">
                                <Grid><StackPanel Spacing="2"><TextBlock Text="Approval queue" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Review commands before atomic or sequential execution" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearApprovalQueueButton_Click" Content="Clear" /></Grid>
                                <Border x:Name="ApprovalQueueEmptyState" Padding="20" CornerRadius="12" Background="{ThemeResource BrandAccentSoftBrush}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="6"><SymbolIcon Symbol="Permissions" Foreground="{ThemeResource BrandAccentBrush}" /><TextBlock Text="Nothing waiting for review" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Choose a task and add it to Change Review." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                                </Border>
                                <ListView x:Name="ApprovalQueueList" Visibility="Collapsed" MinHeight="130" MaxHeight="200" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="3,7"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Position}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Command}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="ExecuteApprovalQueueButton" Style="{ThemeResource BrandPrimaryButtonStyle}" Click="OpenChangeReviewQueueButton_Click" IsEnabled="False" Content="Open Change Review" /><Button Grid.Column="1" Click="SaveWorkflowButton_Click" Content="Save workflow" /></Grid>
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="WorkflowPicker" Header="Saved workflow" PlaceholderText="Choose workflow" /><Button Grid.Column="1" VerticalAlignment="Bottom" Click="LoadWorkflowButton_Click" Content="Load" /></Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid><StackPanel Spacing="2"><TextBlock Text="Command history" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Persistent redacted outcomes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="HistoryRetentionPicker" Width="90" SelectedIndex="1" SelectionChanged="HistoryRetentionPicker_SelectionChanged"><ComboBoxItem Content="25" Tag="25" /><ComboBoxItem Content="100" Tag="100" /><ComboBoxItem Content="250" Tag="250" /></ComboBox><Button Click="ClearCommandHistoryButton_Click" Content="Clear" /></StackPanel></Grid>
                                <ListView x:Name="CommandHistoryList" MinHeight="180" MaxHeight="300" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="3,8" Spacing="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Command}" FontWeight="SemiBold" /><TextBlock Text="{Binding Time}" Grid.Column="1" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxLines="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="OutputPage" Visibility="Collapsed" Padding="28,18,28,28" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><StackPanel Spacing="3"><TextBlock Text="Diagnostics" Style="{ThemeResource PageTitleStyle}" /><TextBlock Text="Inspect Studio output and troubleshoot the active connection" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Click="ExportDiagnosticsButton_Click" AutomationProperties.Name="Create diagnostics bundle"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Save" /><TextBlock Text="Support bundle" /></StackPanel></Button><ComboBox x:Name="OutputFilter" Width="150" SelectedIndex="0" SelectionChanged="OutputFilter_SelectionChanged"><ComboBoxItem Content="All output" Tag="all" /><ComboBoxItem Content="Errors" Tag="error" /><ComboBoxItem Content="Warnings" Tag="warning" /><ComboBoxItem Content="Prints and info" Tag="print" /></ComboBox></StackPanel></Grid>
                    <InfoBar x:Name="OutputSummaryBar" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Title="No output captured" Message="Start a playtest or print from Studio." />
                    <Border Grid.Row="2" Padding="14" CornerRadius="8" Background="{ThemeResource GlassSurfaceStrongBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"><ListView x:Name="OutputList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="4,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontWeight="SemiBold" /><StackPanel Grid.Column="2" Spacing="2"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Text="{Binding Location}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
                </Grid>

                <Grid x:Name="ScriptsPage" Visibility="Collapsed" Padding="28,18,28,28" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="3"><TextBlock Text="Sync" Style="{ThemeResource PageTitleStyle}" /><TextBlock Text="Track source changes reported by the Studio sync companion" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    <Grid x:Name="SyncStatsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="WatchedScriptsCard" Padding="14" CornerRadius="8" Background="{ThemeResource GlassSurfaceBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"><StackPanel><TextBlock Text="WATCHED" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock x:Name="WatchedScriptsText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border><Border x:Name="RecentChangesCard" Grid.Column="1" Padding="14" CornerRadius="8" Background="{ThemeResource GlassSurfaceBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"><StackPanel><TextBlock Text="RECENT CHANGES" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock x:Name="RecentScriptChangesText" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border><Border x:Name="ScriptModeCard" Grid.Column="2" Padding="14" CornerRadius="8" Background="{ThemeResource GlassSurfaceBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"><StackPanel><TextBlock Text="MODE" Style="{ThemeResource CaptionTextBlockStyle}" /><TextBlock x:Name="ScriptModeText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border></Grid>
                    <Border Grid.Row="2" Padding="14" CornerRadius="8" Background="{ThemeResource GlassSurfaceStrongBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"><ListView x:Name="ScriptActivityList" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="4,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding Detail}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1000" Padding="32,24,32,32" Spacing="18" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Settings" Style="{ThemeResource PageTitleStyle}" />
                            <TextBlock Text="Control how Abraxius starts, supervises its host, and integrates with Studio." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{ThemeResource SectionCardStyle}">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="3"><TextBlock Text="Background behavior" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Keep your local Studio bridge available without managing it manually." Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Header="Start Abraxius with Windows" OffContent="Launch manually" OnContent="Starts after sign-in" Toggled="StartupToggle_Toggled" />
                                <ToggleSwitch x:Name="SupervisionToggle" Header="Keep the local host running" OffContent="Supervision paused" OnContent="Automatically recover" IsOn="True" Toggled="SupervisionToggle_Toggled" />
                            </StackPanel>
                        </Border>
                        <Border Style="{ThemeResource SectionCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Storage and support" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Click="LogsButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Document" /><TextBlock Text="Open logs" /></StackPanel></Button>
                                    <Button Click="DataFolderButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Folder" /><TextBlock Text="Open data folder" /></StackPanel></Button>
                                    <Button Click="ExportDiagnosticsButton_Click"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock Text="Create support bundle" /></StackPanel></Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
