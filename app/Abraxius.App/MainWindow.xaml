<Window
    x:Class="Abraxius.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Abraxius">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppCanvasBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Abraxius" Subtitle="Roblox Studio workspace" Background="{ThemeResource NavigationSurfaceBrush}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView Grid.Row="1" x:Name="CategoryNavigation" Background="Transparent" PaneDisplayMode="Auto" CompactPaneLength="52" OpenPaneLength="196" IsPaneToggleButtonVisible="True" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="CategoryNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNavigationItem" Content="Home" Tag="overview" IsSelected="True"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" Foreground="{ThemeResource BrandAccentBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="playtest"><NavigationViewItem.Icon><SymbolIcon Symbol="Play" Foreground="{ThemeResource BrandWarmBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Intelligence" Tag="intelligence"><NavigationViewItem.Icon><SymbolIcon Symbol="View" Foreground="{ThemeResource BrandSecondaryBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Sync" Tag="scripts"><NavigationViewItem.Icon><SymbolIcon Symbol="Sync" Foreground="{ThemeResource BrandSecondaryBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Code" Tag="code"><NavigationViewItem.Icon><SymbolIcon Symbol="Edit" Foreground="{ThemeResource BrandAccentBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="ReviewNavigationItem" Content="Review" Tag="review"><NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" Foreground="{ThemeResource BrandWarmBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="AI" Tag="ai"><NavigationViewItem.Icon><SymbolIcon Symbol="Message" Foreground="{ThemeResource BrandWarmBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Commands" Tag="commands"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" Foreground="{ThemeResource BrandAccentBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="output"><NavigationViewItem.Icon><SymbolIcon Symbol="Message" Foreground="{ThemeResource BrandWarmBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" Foreground="{ThemeResource BrandSecondaryBrush}" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
        <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="32,24,32,32" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />

                <Border Grid.Row="1" Margin="0,10,0,0" Style="{ThemeResource HeroCardStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="ABRAXIUS CONTROL DECK" Style="{ThemeResource EyebrowTextStyle}" />
                            <TextBlock Text="Studio workspace" Style="{ThemeResource PageTitleStyle}" />
                            <TextBlock x:Name="DetailText" Text="Reading local host status..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="RefreshButton" Click="RefreshButton_Click" Width="40" Height="40" Padding="0" Background="{ThemeResource BrandAccentSoftBrush}" Foreground="{ThemeResource BrandAccentBrush}" AutomationProperties.Name="Refresh status" ToolTipService.ToolTip="Refresh status">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button x:Name="CopyStatusButton" Click="CopyStatusButton_Click" Width="40" Height="40" Padding="0" Background="{ThemeResource BrandSecondarySoftBrush}" Foreground="{ThemeResource BrandSecondaryBrush}" AutomationProperties.Name="Copy status" ToolTipService.ToolTip="Copy status summary">
                                <SymbolIcon Symbol="Copy" />
                            </Button>
                            <Button x:Name="DataFolderButton" Click="DataFolderButton_Click" Width="40" Height="40" Padding="0" Background="{ThemeResource BrandWarmSoftBrush}" Foreground="{ThemeResource BrandWarmBrush}" AutomationProperties.Name="Open data folder" ToolTipService.ToolTip="Open Abraxius data folder">
                                <SymbolIcon Symbol="Folder" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="HomeStatusGrid" Grid.Row="2" Margin="0,18,0,0" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ServerStatusCard" Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource ServerCardBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{ThemeResource IconTileStyle}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <FontIcon Glyph="&#xE968;" FontSize="17" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="SERVER" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="ServerDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ServerStatus" Text="Checking" FontSize="17" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Local API :13470" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="StudioStatusCard" Grid.Column="1" Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource StudioCardBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Style="{ThemeResource IconTileStyle}">
                                <FontIcon Glyph="&#xE774;" FontSize="17" Foreground="{ThemeResource BrandAccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="STUDIO LINK" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="StudioDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StudioStatus" Text="Checking" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="Advanced tool connection" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ForceMcpButton" Grid.Column="2" Width="34" Height="34" Padding="0" VerticalAlignment="Center" Click="ForceMcpButton_Click" AutomationProperties.Name="Force MCP connection" ToolTipService.ToolTip="Release port 13469 and reconnect MCP">
                                <SymbolIcon Symbol="Sync" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border x:Name="PluginStatusCard" Grid.Column="2" Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource SyncCardBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{ThemeResource IconTileStyle}" Background="{ThemeResource BrandSecondarySoftBrush}">
                                <FontIcon Glyph="&#xE8D4;" FontSize="17" Foreground="{ThemeResource BrandSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="STUDIO SYNC" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="PluginDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PluginStatus" Text="Checking" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="Script inspection and sync" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="HomeControlsGrid" Grid.Row="3" Margin="0,14,0,0" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ServerControlsCard" Style="{ThemeResource SectionCardStyle}" Background="{ThemeResource CardSurfaceStrongBrush}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Server controls" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="RUST HOST" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartButton" Click="StartButton_Click" Style="{ThemeResource BrandPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Play" />
                                        <TextBlock x:Name="StartButtonText" Text="Start server" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StopButton" Click="StopButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Stop" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LogsButton" Click="LogsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Document" />
                                        <TextBlock Text="Logs" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="InstallPluginButton" Click="InstallPluginButton_Click" ToolTipService.ToolTip="Install or update the Abraxius companion in Roblox Studio">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Download" />
                                        <TextBlock x:Name="PluginInstallButtonText" Text="Install Roblox plugin" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="PluginInstallStatusText" Text="Ready to install" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="18" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="API endpoint" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="127.0.0.1:13470" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Sync transport" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TransportText" Text="Checking" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="MCP tools" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ToolsLoadedText" Text="--" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Last refresh" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="LastCheckedText" Text="--" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RuntimeCard" Grid.Column="1" Style="{ThemeResource SectionCardStyle}">
                        <StackPanel Spacing="13">
                            <TextBlock Text="Runtime" FontSize="16" FontWeight="SemiBold" />
                            <Grid RowSpacing="11" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HostVersionText" Grid.Column="1" Text="--" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="Process ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ProcessIdText" Grid.Row="1" Grid.Column="1" Text="--" HorizontalAlignment="Right" FontFamily="Consolas" />
                                <TextBlock Grid.Row="2" Text="Uptime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="UptimeText" Grid.Row="2" Grid.Column="1" Text="--" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="3" Text="Supervision" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SupervisionStatusText" Grid.Row="3" Grid.Column="1" Text="Enabled" HorizontalAlignment="Right" />
                            </Grid>
                            <InfoBar x:Name="ConnectionInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Companion sync available" Message="Pull and existing-script push work without legacy MCP." />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Margin="0,14,0,0" Style="{ThemeResource SectionCardStyle}" Background="{ThemeResource CardSurfaceStrongBrush}">
                    <StackPanel Spacing="13">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Live analytics" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Studio probe and Windows process telemetry" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                <Ellipse x:Name="AnalyticsDot" Width="7" Height="7" Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                                <TextBlock x:Name="AnalyticsFreshnessText" Text="Waiting on :13472" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="STUDIO PROBE" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="StudioMemoryText" Text="Memory  --" />
                                <TextBlock x:Name="StudioRoleText" Text="Role  --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="StudioPhysicsText" Text="Physics  --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="WINDOWS PROCESSES" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="StudioResourcesText" Text="Studio  --" />
                                <TextBlock x:Name="DaemonResourcesText" Text="Rust host  --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PlayerCountText" Text="Players  --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="DATA MODEL" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="InstanceCountText" Text="Instances  --" />
                                <TextBlock x:Name="ScriptCountText" Text="Scripts  --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PartCountText" Text="Parts  --" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

                <Grid x:Name="PlaytestPage" Visibility="Collapsed" Padding="28,18,28,28" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Activity" Style="{ThemeResource PageTitleStyle}" />
                            <TextBlock Text="Live playtest health, output, and runtime signals" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource StudioCardBrush}"><StackPanel Spacing="3"><TextBlock Text="SESSION" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource BrandAccentBrush}" /><TextBlock x:Name="PlaytestStateText" Text="Waiting" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="PlaytestDurationText" Text="--" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource BrandWarmSoftBrush}"><StackPanel Spacing="3"><TextBlock Text="ERRORS" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource BrandWarmBrush}" /><TextBlock x:Name="PlaytestErrorText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource CardSurfaceBrush}"><StackPanel Spacing="3"><TextBlock Text="WARNINGS" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="PlaytestWarningText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" /></StackPanel></Border>
                            <Border Grid.Column="3" Style="{ThemeResource StatusCardStyle}" Background="{ThemeResource SyncCardBrush}"><StackPanel Spacing="3"><TextBlock Text="PRINTS" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource BrandSecondaryBrush}" /><TextBlock x:Name="PlaytestPrintText" Text="0" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource GlassSurfaceStrongBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1">
                                <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Recent runtime output" FontSize="16" FontWeight="SemiBold" /><ListView x:Name="PlaytestOutputList" Grid.Row="1" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="2,6" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding LevelLabel}" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxLines="3" /><TextBlock Text="{Binding Location}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>
                            </Border>
                            <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource GlassSurfaceBrush}" BorderBrush="{ThemeResource GlassStrokeBrush}" BorderThickness="1"><StackPanel Spacing="9"><TextBlock Text="Runtime probe" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="PlaytestMemoryText" Text="Memory  --" /><TextBlock x:Name="PlaytestPlayersText" Text="Players  --" /><TextBlock x:Name="PlaytestPhysicsText" Text="Physics  --" /><TextBlock x:Name="PlaytestSceneText" Text="Scene  --" TextWrapping="Wrap" /></StackPanel></Border>
                        </Grid>
                </Grid>

                <Grid x:Name="IntelligencePage" Visibility="Collapsed" Padding="28,18,28,28" RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><StackPanel Spacing="3"><TextBlock Text="Studio intelligence" Style="{ThemeResource PageTitleStyle}" /><TextBlock Text="Correlated runtime signals and reviewable local suggestions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse x:Name="IntelligenceStatusDot" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" /><TextBlock x:Name="IntelligenceStatusText" Text="Observing" /></StackPanel></Grid>
                    <Grid x:Name="IntelligenceWorkspaceGrid" Grid.Row="1" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition x:Name="IntelligenceTimelineColumn" Width="0.8*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition x:Name="IntelligenceSettingsColumn" Width="300" /></Grid.ColumnDefinitions>
                        <Border Style="{ThemeResource SectionCardStyle}" Padding="14"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Timeline" FontSize="18" FontWeight="SemiBold" /><ListView x:Name="IntelligenceTimelineList" Grid.Row="1" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="3,7" Spacing="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxLines="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Time}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
                        <Border Grid.Column="1" Style="{ThemeResource SectionCardStyle}" Padding="14"><Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Suggestion inbox" FontSize="18" FontWeight="SemiBold" /><ListView x:Name="IntelligenceSuggestionList" Grid.Row="1" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Confidence}" Foreground="{ThemeResource BrandAccentBrush}" /></Grid><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" MaxLines="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Time}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Click="DismissIntelligenceSuggestionButton_Click" Content="Dismiss" /><Button Click="SummarizeIntelligenceSuggestionButton_Click" Content="Classify locally" /><Button Click="EscalateIntelligenceSuggestionButton_Click" Content="Escalate to 7B" /></StackPanel></Grid></Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12"><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Observe mode" Message="Rules suggest; models summarize only when requested." /><Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="10"><TextBlock Text="Signals" FontSize="18" FontWeight="SemiBold" /><ToggleSwitch x:Name="IntelligenceErrorsToggle" Header="Errors and warnings" IsOn="True" /><ToggleSwitch x:Name="IntelligencePerformanceToggle" Header="Performance anomalies" IsOn="True" /><ToggleSwitch x:Name="IntelligenceChangesToggle" Header="Script and mode changes" IsOn="True" /><ToggleSwitch x:Name="IntelligenceQuietHoursToggle" Header="Quiet hours (10 PM–8 AM)" /></StackPanel></Border><Border Style="{ThemeResource SectionCardStyle}"><StackPanel Spacing="10"><TextBlock Text="Thresholds" FontSize="18" FontWeight="SemiBold" /><NumberBox x:Name="IntelligenceRepeatThreshold" Header="Repeated error count" Value="3" Minimum="2" Maximum="20" /><NumberBox x:Name="IntelligenceWarningThreshold" Header="Warning spike" Value="3" Minimum="1" Maximum="50" /><NumberBox x:Name="IntelligenceMemoryThreshold" Header="Memory increase (MB)" Value="100" Minimum="10" Maximum="2000" /><NumberBox x:Name="IntelligencePhysicsThreshold" Header="Low physics FPS" Value="45" Minimum="1" Maximum="60" /></StackPanel></Border><Button Click="ClearIntelligenceTimelineButton_Click" Content="Clear timeline" /></StackPanel></ScrollViewer>
                    </Grid>
                </Grid>

                <Grid x:Name="CodePage" Visibility="Collapsed" Padding="24,18,24,24" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3"><TextBlock Text="Code" Style="{ThemeResource PageTitleStyle}" /><TextBlock Text="Pull, edit, preview, and safely push Luau source to Studio." Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        <TextBlock x:Name="EditorDirtyText" Grid.Column="1" Text="No script loaded" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="EditorScriptPathTextBox" Header="Studio script path" PlaceholderText="ServerScriptService.MyScript" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="PullEditorScriptButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Download" /><TextBlock Text="Pull" /></StackPanel></Button>
                        <Button x:Name="PreviewEditorChangesButton" Grid.Column="2" VerticalAlignment="Bottom" Click="PreviewEditorChangesButton_Click" IsEnabled="False" Content="Preview changes" />
                        <Button x:Name="PushEditorChangesButton" Grid.Column="3" VerticalAlignment="Bottom" Style="{ThemeResource BrandPrimaryButtonStyle}" Click="PushEditorChangesButton_Click" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Permissions" /><TextBlock Text="Review change" /></StackPanel></Button>
                    </Grid>
                    <TabView x:Name="EditorTabs" Grid.Row="2" IsAddTabButtonVisible="False" TabCloseRequested="EditorTabs_TabCloseRequested" SelectionChanged="EditorTabs_SelectionChanged" />
                    <Grid x:Name="CodeWorkspaceGrid" Grid.Row="3" ColumnSpacing="12">
