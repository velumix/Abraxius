{
  "name": "abraxius",
  "version": "1.1.0",
  "description": "AI-ready MCP bridge, Studio companion plugin, and script sync for Roblox Studio",
  "main": "client.js",
  "bin": {
    "abraxius": "./cli.js",
    "mcp": "./cli.js"
  },
  "scripts": {
    "start": "node server.js start",
    "stop": "node server.js stop",
    "status": "node server.js status",
    "example": "node examples/basic.js",
    "docs:dev": "moonwave dev --code .moonwave/stub",
    "docs:build": "moonwave build --fresh --code .moonwave/stub",
    "smoke": "node scripts/smoke.js",
    "test": "node --test test/*.test.js",
    "plugin:build": "node scripts/build-plugin.js",
    "rust:check": "cargo check --manifest-path rust/abraxius-rs/Cargo.toml",
    "rust:build": "cargo build --release --manifest-path rust/abraxius-rs/Cargo.toml",
    "rust:run": "cargo run --manifest-path rust/abraxius-rs/Cargo.toml --bin abraxius --",
    "rust:daemon": "cargo run --manifest-path rust/abraxius-rs/Cargo.toml --bin abraxius-daemon",
    "app:build": "npm run rust:build && dotnet build app/Abraxius.App/Abraxius.App.csproj -c Release -p:Platform=x64",
    "app:run": "dotnet run --project app/Abraxius.App/Abraxius.App.csproj -c Release -p:Platform=x64",
    "linux:run": "electron app/Abraxius.Linux/main.js",
    "linux:tauri:build": "cargo build --release --manifest-path app/Abraxius.Linux/src-tauri/Cargo.toml",
    "linux:tauri:install": "sh app/Abraxius.Linux/install.sh",
    "linux:install": "sh app/Abraxius.Linux/install.sh",
    "install-plugin": "node scripts/install-plugin.js",
    "plugin": "node scripts/install-plugin.js"
  },
  "keywords": [
    "roblox",
    "mcp",
    "studio",
    "websocket",
    "cli",
    "sync",
    "luau",
    "ai-context",
    "roblox-studio"
  ],
  "author": "Velumix",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "octokit": "^5.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^37.2.6",
    "monaco-editor": "^0.55.1",
    "moonwave": "^1.4.2"
  }
}
